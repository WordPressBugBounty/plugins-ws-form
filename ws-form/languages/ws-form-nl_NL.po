#: includes/third-party/abuseipdb/class-ws-form-abuseipdb.php:501
#: includes/third-party/akismet/class-ws-form-akismet.php:432
msgid ""
"If checked, this check will not run if you are signed in as an administrator."
msgstr ""
"Indien aangevinkt, wordt deze controle niet uitgevoerd als je bent aangemeld "
"als beheerder."

#: includes/config/class-ws-form-config-option.php:1068
#: includes/core/class-ws-form-submit-note.php:354
#: includes/third-party/abuseipdb/class-ws-form-abuseipdb.php:341
msgid "Abuse Confidence Score"
msgstr "Misbruikvertrouwensscore"

#: includes/config/class-ws-form-config-option.php:1074
msgid ""
"Optional. If set (0–100), submissions at or above this AbuseIPDB score are "
"treated as spam on every form. If left blank, each form’s Spam Threshold "
"setting is used instead."
msgstr ""
"Optioneel. Indien ingesteld (0–100), worden inzendingen met deze AbuseIPDB-"
"score of hoger op elk formulier als spam behandeld. Als dit leeg wordt "
"gelaten, wordt in plaats daarvan de instelling Spam-drempel van elk "
"formulier gebruikt."

#: includes/config/class-ws-form-config-option.php:1079
msgid "Report Window (Days)"
msgstr "Rapportvenster (dagen)"

#: includes/config/class-ws-form-config-option.php:1084
msgid "Only consider AbuseIPDB reports within this many days (1–365)."
msgstr ""
"Houd alleen rekening met AbuseIPDB-meldingen van de afgelopen zoveel dagen "
"(1–365)."

