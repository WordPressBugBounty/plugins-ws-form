msgstr ""
"Tag della lingua dal browser del visitatore <code>navigator.language</code> "
"(RFC 5646; ISO 639 con regione ISO 3166-1 alpha-2 opzionale; separato da "
"trattini; ad esempio <code>en-US</code>). Solo lato client; vuoto quando "
"viene analizzato sul server."

#: includes/class-ws-form-config.php:21283
msgid "Locale (Browser)"
msgstr "Impostazioni locali (browser)"

#: includes/class-ws-form-config.php:21284
msgid ""
"POSIX-style locale derived from the browser tag: underscores instead of "
"hyphens (WordPress/POSIX-style; for example <code>en_US</code>). Region uses "
"ISO 3166-1 alpha-2 when present. Client-side only; empty when parsed on the "
"server."
msgstr ""
"Locale in stile POSIX derivata dal tag del browser: underscore al posto dei "
"trattini (stile WordPress/POSIX; ad esempio <code>en_US</code>). La regione "
"usa ISO 3166-1 alpha-2 quando presente. Solo lato client; vuoto quando viene "
"analizzato sul server."

#: includes/class-ws-form-config.php:21290
msgid "Language Code (Browser)"
msgstr "Codice lingua (browser)"

#: includes/class-ws-form-config.php:21291
msgid ""
"Primary language subtag from the browser locale (ISO 639; lowercase, "
"typically ISO 639-1). Client-side only; empty when parsed on the server."
msgstr ""
"Sottotag della lingua principale dalle impostazioni locali del browser (ISO "
"639; minuscolo, in genere ISO 639-1). Solo lato client; vuoto quando "
"analizzato sul server."

#: includes/class-ws-form-config.php:21297
msgid "Country Code (Browser)"
msgstr "Codice paese (browser)"

#: includes/class-ws-form-config.php:21298
