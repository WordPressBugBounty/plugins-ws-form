#: includes/class-ws-form-config.php:21276
msgid "Language (Browser)"
msgstr "Lingua (browser)"

#: includes/class-ws-form-config.php:21277
msgid ""
"Language tag from the visitor's browser <code>navigator.language</code> (RFC "
