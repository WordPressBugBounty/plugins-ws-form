msgstr "Returnerer den indtastede strengs version med store bogstaver i ord."

#: includes/class-ws-form-config.php:22507
msgid "Uppercase first letter"
msgstr "Første bogstav med store bogstaver"

#: includes/class-ws-form-config.php:22512
msgid "Returns the uppercase first letter version of the input string."
msgstr "Returnerer den store bogstavsversion af den indtastede streng."

#: includes/class-ws-form-config.php:22519
msgid "Capitalize a string"
msgstr "Gør en streng med stort begyndelsesbogstav"

#: includes/class-ws-form-config.php:22524
msgid "Returns the capitalized version of an input string."
msgstr "Returnerer den versalerede version af en indtastet streng."

#: includes/class-ws-form-config.php:22531
msgid "Sentence case a string"
msgstr "Sætningskase en streng"

#: includes/class-ws-form-config.php:22536
