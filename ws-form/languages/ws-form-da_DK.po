msgstr ""
"Returnerer indstillingen <strong>Administratorens e-mailadresse</strong> i "
"<strong>WordPress-indstillinger &gt; Generelt</strong>."

#: includes/class-ws-form-config.php:21231
#: includes/class-ws-form-config.php:21304
#: includes/class-ws-form-config.php:21343
msgid "Current Time"
msgstr "Nuværende tid"

#: includes/class-ws-form-config.php:21233
