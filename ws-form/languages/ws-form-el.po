msgstr "Κωδικός"

#: includes/actions/class-ws-form-action-custom-api.php:1077
msgid "Handler"
msgstr "Χειριστής"

#: includes/actions/class-ws-form-action-custom-api.php:1081
msgid "Ignore"
msgstr "Παράβλεψη"

#: includes/actions/class-ws-form-action-custom-api.php:1082
msgid "Process Response Field Mapping"
msgstr "Επεξεργασία αντιστοίχισης πεδίου απόκρισης"

#: includes/actions/class-ws-form-action-custom-api.php:1083
msgid "Throw error"
msgstr "Ρίψη σφάλματος"

#: includes/actions/class-ws-form-action-custom-api.php:1084
msgid "Halt"
msgstr "Παύση"

