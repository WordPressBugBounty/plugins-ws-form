#. translators: %s: License key expiry date
#: includes/class-ws-form-licensing.php:308
#, php-format
msgid "Your license key expired on %s."
msgstr "Το κλειδί άδειας χρήσης σας έληξε την %s."

#: includes/class-ws-form-licensing.php:320
msgid "Your license key has been disabled."
msgstr "Το κλειδί άδειας έχει απενεργοποιηθεί."

#: includes/class-ws-form-licensing.php:324
msgid "Invalid license."
msgstr "Μη έγκυρη άδεια."

#: includes/class-ws-form-licensing.php:329
msgid "Your license is not active for this URL."
msgstr "Η άδεια χρήσης σας δεν είναι ενεργή για αυτήν τη διεύθυνση URL."

#: includes/class-ws-form-licensing.php:333
msgid ""
"License not activable. You are entering the license key for the package you "
"purchased rather than the license key for the plugin itself."
msgstr ""
"Δεν είναι δυνατή η ενεργοποίηση της άδειας χρήσης. Εισάγετε το κλειδί άδειας "
"χρήσης για το πακέτο που αγοράσατε αντί για το κλειδί άδειας χρήσης για το "
"ίδιο το πρόσθετο."

#. translators: %s: Plugin name
#: includes/class-ws-form-licensing.php:342
#, php-format
msgid "This appears to be an invalid license key for %s."
msgstr "Αυτό φαίνεται να είναι ένα μη έγκυρο κλειδί άδειας χρήσης για το %s."

#: includes/class-ws-form-licensing.php:350
msgid "Your license key has reached its activation limit."
msgstr "Το κλειδί άδειας χρήσης σας έχει φτάσει το όριο ενεργοποίησης."

#: includes/class-ws-form-licensing.php:354
msgid "Invalid item ID."
msgstr "Μη έγκυρο ID στοιχείου."

#: includes/class-ws-form-licensing.php:358
msgid "License activation failed because the product ID was missing."
msgstr "Η ενεργοποίηση της άδειας απέτυχε επειδή έλειπε το ID προϊόντος."

#: includes/class-ws-form-licensing.php:362
msgid "License activation failed because no site URL was provided."
msgstr "Η ενεργοποίηση της άδειας απέτυχε επειδή δεν δόθηκε URL ιστότοπου."

#: includes/class-ws-form-licensing.php:366
msgid ""
"This license key belongs to a bundle and cannot be used to activate "
"individual plugins. Please enter the license key for this specific WS Form "
"product."
msgstr ""
"Αυτό το κλειδί άδειας χρήσης ανήκει σε πακέτο και δεν μπορεί να "
"χρησιμοποιηθεί για την ενεργοποίηση μεμονωμένων προσθέτων. Παρακαλούμε "
"εισαγάγετε το κλειδί άδειας χρήσης για αυτό το συγκεκριμένο προϊόν WS Form."

#: includes/class-ws-form-licensing.php:370
msgid "The provided license key does not match this product."
msgstr "Το κλειδί άδειας χρήσης που δόθηκε δεν αντιστοιχεί σε αυτό το προϊόν."

#. translators: %s: Licensing error message
#: includes/class-ws-form-licensing.php:382
#, php-format
msgid "License activation failed: %s"
msgstr "Η ενεργοποίηση της άδειας απέτυχε: %s"

#: includes/class-ws-form-licensing.php:405
msgid "License key successfully activated"
msgstr "Το κλειδί άδειας ενεργοποιήθηκε με επιτυχία"

#: includes/class-ws-form-licensing.php:490
msgid ""
"Your license key deactivation failed. If you have changed hostnames you can "
"disregard this message."
msgstr ""
"Η απενεργοποίηση του κλειδιού άδειας χρήσης απέτυχε. Αν έχετε αλλάξει "
"ονόματα κεντρικού υπολογιστή, μπορείτε να αγνοήσετε αυτό το μήνυμα."

#: includes/class-ws-form-licensing.php:506
msgid "License key successfully deactivated"
msgstr "Το κλειδί άδειας απενεργοποιήθηκε με επιτυχία"

#. translators: %1$s: Plugin name, %2$s: Opening anchor tag, %3$s: Closing anchor tag
#: includes/class-ws-form-licensing.php:732
#, php-format
msgid ""
"%1$s is not licensed. Please enter your license key in %2$ssettings%3$s to "
"receive software updates and support."
msgstr ""
"Το %1$s δεν διαθέτει άδεια χρήσης. Παρακαλούμε εισαγάγετε το κλειδί άδειας "
"χρήσης σας στις %2$sρυθμίσεις%3$s για να λαμβάνετε ενημερώσεις λογισμικού "
"και υποστήριξη."

#. translators: %s: Presentable plugin name, e.g. WS Form PRO
#: includes/class-ws-form-widget.php:24
#, php-format
msgid "Displays a form created with %s."
msgstr "Εμφανίζει μια φόρμα που δημιουργήθηκε με το %s."

#: includes/class-ws-form-widget.php:51
msgid "Title:"
msgstr "Τίτλος:"

#: includes/config/class-ws-form-config-ability-structure.php:100
msgid "List tabs"
msgstr "Λίστα καρτελών"

#: includes/config/class-ws-form-config-ability-structure.php:101
msgid ""
"Returns all tabs (groups) for a form with id, label, and 1-based index. Use "
"tab IDs with tab-update, tab-delete, and section-add (group_id)."
msgstr ""
"Επιστρέφει όλες τις καρτέλες (ομάδες) για μια φόρμα με id, ετικέτα και "
"δείκτη με βάση το 1. Χρησιμοποιήστε τα ID καρτελών με τα tab-update, tab-"
"delete και section-add (group_id)."

#: includes/config/class-ws-form-config-ability-structure.php:141
msgid "List sections"
msgstr "Λίστα ενοτήτων"

#: includes/config/class-ws-form-config-ability-structure.php:142
msgid ""
"Returns all sections for a form with id, label, parent group_id (tab id), "
"and index. Use with section-update, section-delete, and field-add."
msgstr ""
"Επιστρέφει όλες τις ενότητες για μια φόρμα με id, ετικέτα, γονικό group_id "
"(id καρτέλας) και δείκτη. Χρησιμοποιήστε το με τα section-update, section-"
"delete και field-add."

#: includes/config/class-ws-form-config-ability-structure.php:183
msgid "List fields"
msgstr "Λίστα πεδίων"

#: includes/config/class-ws-form-config-ability-structure.php:184
msgid ""
"Returns all fields for a form with id, label, type, section_id, and "
"group_id. Prefer this over form-get-json when you only need to find field "
"IDs for field-update, field-delete, or field-add."
msgstr ""
"Επιστρέφει όλα τα πεδία για μια φόρμα με id, label, type, section_id και "
"group_id. Προτιμήστε αυτό αντί του form-get-json όταν χρειάζεται μόνο να "
"βρείτε ID πεδίων για τα field-update, field-delete ή field-add."

#: includes/config/class-ws-form-config-ability-structure.php:226
msgid "Add tab"
msgstr "Προσθήκη καρτέλας"

#: includes/config/class-ws-form-config-ability-structure.php:227
msgid ""
"Add a tab (group) to a form. First use the tabs tool if you need existing "
"tab IDs. When a form has multiple tabs, also add tab_next / tab_previous "
"fields with field-add as needed."
msgstr ""
"Προσθέστε μια καρτέλα (ομάδα) σε μια φόρμα. Πρώτα χρησιμοποιήστε το εργαλείο "
"καρτελών, αν χρειάζεστε υπάρχοντα ID καρτελών. Όταν μια φόρμα έχει πολλαπλές "
"καρτέλες, προσθέστε επίσης πεδία tab_next / tab_previous με το field-add, "
"όπως απαιτείται."

#: includes/config/class-ws-form-config-ability-structure.php:277
msgid "Update tab"
msgstr "Ενημέρωση καρτέλας"

#: includes/config/class-ws-form-config-ability-structure.php:278
msgid "Update a tab label by tab ID. Use the tabs tool to get tab IDs."
msgstr ""
"Ενημερώστε μια ετικέτα καρτέλας βάσει ID καρτέλας. Χρησιμοποιήστε το "
"εργαλείο καρτελών για να λάβετε τα ID καρτελών."

#: includes/config/class-ws-form-config-ability-structure.php:326
msgid "Delete tab"
msgstr "Διαγραφή καρτέλας"

#: includes/config/class-ws-form-config-ability-structure.php:327
msgid ""
"Permanently delete a tab and its sections/fields. Cannot delete the last tab "
"on a form. Use the tabs tool to get tab IDs."
msgstr ""
"Διαγράψτε οριστικά μια καρτέλα και τις ενότητες/πεδία της. Δεν είναι δυνατή "
"η διαγραφή της τελευταίας καρτέλας σε μια φόρμα. Χρησιμοποιήστε το εργαλείο "
"καρτελών για να λάβετε τα ID καρτελών."

#: includes/config/class-ws-form-config-ability-structure.php:362
msgid "Add section"
msgstr "Προσθήκη ενότητας"

#: includes/config/class-ws-form-config-ability-structure.php:363
msgid ""
"Add a section to a tab. Use tabs to get group_id (tab id), and sections if "
"inserting before another section."
msgstr ""
"Προσθέστε μια ενότητα σε μια καρτέλα. Χρησιμοποιήστε τις καρτέλες για να "
"λάβετε το group_id (id καρτέλας) και τις ενότητες αν γίνεται εισαγωγή πριν "
"από κάποια άλλη ενότητα."

#: includes/config/class-ws-form-config-ability-structure.php:425
msgid "Update section"
msgstr "Ενημέρωση ενότητας"

#: includes/config/class-ws-form-config-ability-structure.php:426
msgid ""
"Update a section label and/or meta (label_render). Use the sections tool to "
"get section IDs."
msgstr ""
"Ενημερώστε μια ετικέτα ενότητας και/ή τα meta (label_render). Χρησιμοποιήστε "
"το εργαλείο ενοτήτων για να λάβετε τα ID ενοτήτων."

#: includes/config/class-ws-form-config-ability-structure.php:482
msgid "Delete section"
msgstr "Διαγραφή ενότητας"

#: includes/config/class-ws-form-config-ability-structure.php:483
msgid ""
"Permanently delete a section and its fields. Cannot delete the last section "
"on a tab. Use the sections tool to get section IDs."
msgstr ""
"Διαγράψτε οριστικά μια ενότητα και τα πεδία της. Δεν είναι δυνατή η διαγραφή "
"της τελευταίας ενότητας σε μια καρτέλα. Χρησιμοποιήστε το εργαλείο ενοτήτων "
"για να λάβετε τα ID των ενοτήτων."

#: includes/config/class-ws-form-config-ability-structure.php:522
msgid "List actions"
msgstr "Λίστα ενεργειών"

#: includes/config/class-ws-form-config-ability-structure.php:523
msgid ""
"Returns form actions (including Send Email notifications) with row_id, "
"index, type id, label, and meta_summary. Prefer row_id for action-update and "
"action-delete. Form notifications are Send Email actions, not form settings."
msgstr ""
"Επιστρέφει ενέργειες φόρμας (συμπεριλαμβανομένων ειδοποιήσεων Αποστολή "
"email) με row_id, index, type id, label και meta_summary. Προτιμήστε το "
"row_id για τα action-update και action-delete. Οι ειδοποιήσεις φόρμας είναι "
"ενέργειες Αποστολή email, όχι ρυθμίσεις φόρμας."

#: includes/config/class-ws-form-config-ability-structure.php:565
msgid "Add action"
msgstr "Προσθήκη ενέργειας"

#: includes/config/class-ws-form-config-ability-structure.php:566
msgid ""
"Add a form action such as a Send Email notification. Prefer this over form-"
"update-json for adding notifications. For the person completing the form, "
"set meta.to to #field(id) for their email field. Returns a stable row_id."
msgstr ""
"Προσθέστε μια ενέργεια φόρμας, όπως μια ειδοποίηση Αποστολή email. "
"Προτιμήστε αυτό αντί του form-update-json για την προσθήκη ειδοποιήσεων. Για "
"το άτομο που συμπληρώνει τη φόρμα, ορίστε το meta.to σε #field(id) για το "
"πεδίο email του. Επιστρέφει ένα σταθερό row_id."

#: includes/config/class-ws-form-config-ability-structure.php:620
msgid "Update action"
msgstr "Ενημέρωση ενέργειας"

#: includes/config/class-ws-form-config-ability-structure.php:621
msgid ""
"Update an action by row_id (preferred), index, or unique label_match. Use "
"the actions tool first. Prefer this for editing email notifications."
msgstr ""
"Ενημερώστε μια ενέργεια με βάση το row_id (προτιμώμενο), το index ή ένα "
"μοναδικό label_match. Χρησιμοποιήστε πρώτα το εργαλείο ενεργειών. Προτιμήστε "
"αυτό για την επεξεργασία ειδοποιήσεων email."

#: includes/config/class-ws-form-config-ability-structure.php:671
msgid "Delete action"
msgstr "Διαγραφή ενέργειας"

#: includes/config/class-ws-form-config-ability-structure.php:672
msgid ""
"Delete an action by row_id (preferred), index, or unique label_match. Cannot "
"delete the last email, message, or database action."
msgstr ""
"Διαγράψτε μια ενέργεια με βάση το row_id (προτιμώμενο), το index ή ένα "
"μοναδικό label_match. Δεν είναι δυνατή η διαγραφή της τελευταίας ενέργειας "
"email, μηνύματος ή βάσης δεδομένων."

#: includes/config/class-ws-form-config-ability-structure.php:707
msgid "List conditionals"
msgstr "Λίστα συνθηκών"

#: includes/config/class-ws-form-config-ability-structure.php:708
msgid ""
"Returns form conditionals with row_id, index, label, and a short IF/THEN "
"summary. Prefer row_id for conditional-update and conditional-delete."
msgstr ""
"Επιστρέφει τις συνθήκες φόρμας με row_id, index, label και μια σύντομη "
"σύνοψη IF/THEN. Προτιμήστε το row_id για τα conditional-update και "
"conditional-delete."

#: includes/config/class-ws-form-config-ability-structure.php:749
msgid "Add conditional"
msgstr "Προσθήκη συνθήκης"

#: includes/config/class-ws-form-config-ability-structure.php:750
msgid ""
"Add a conditional logic rule. Use the same AI shape as form-create-json "
"conditionals. Action targets use action row_id from the actions tool."
msgstr ""
"Προσθέστε έναν κανόνα λογικής υπό όρους. Χρησιμοποιήστε την ίδια μορφή AI "
"όπως οι συνθήκες του form-create-json. Οι στόχοι ενέργειας χρησιμοποιούν το "
"row_id ενέργειας από το εργαλείο actions."

#: includes/config/class-ws-form-config-ability-structure.php:790
msgid "Update conditional"
msgstr "Ενημέρωση συνθήκης"

#: includes/config/class-ws-form-config-ability-structure.php:791
msgid ""
"Replace a conditional by row_id (preferred), index, or unique label_match. "
"Pass the full conditional object in AI shape."
msgstr ""
"Αντικαταστήστε μια συνθήκη με row_id (προτιμώμενο), index ή μοναδικό "
"label_match. Περάστε το πλήρες αντικείμενο συνθήκης σε μορφή AI."

#: includes/config/class-ws-form-config-ability-structure.php:835
msgid "Delete conditional"
msgstr "Διαγραφή συνθήκης"

#: includes/config/class-ws-form-config-ability-structure.php:836
msgid ""
"Delete a conditional by row_id (preferred), index, or unique label_match. "
"Use the conditionals tool first."
msgstr ""
"Διαγράψτε μια συνθήκη με βάση το row_id (προτιμώμενο), το index ή ένα "
"μοναδικό label_match. Χρησιμοποιήστε πρώτα το εργαλείο συνθηκών."

#: includes/config/class-ws-form-config-ability.php:27
msgid "List forms"
msgstr "Λίστα φορμών"

#: includes/config/class-ws-form-config-ability.php:28
msgid ""
"Returns a list of forms in WS Form. Each form includes folder_id. 0 means "
"the form is not in a folder. Pass folder_id to list only the forms assigned "
"to that folder. Omit folder_id to list every form. A parent folder does not "
"include forms in its subfolders."
msgstr ""
"Επιστρέφει μια λίστα φορμών στο WS Form. Κάθε φόρμα περιλαμβάνει folder_id. "
"Το 0 σημαίνει ότι η φόρμα δεν βρίσκεται σε φάκελο. Περάστε το folder_id για "
"να εμφανιστούν μόνο οι φόρμες που έχουν αντιστοιχιστεί σε αυτόν τον φάκελο. "
"Παραλείψτε το folder_id για να εμφανιστεί κάθε φόρμα. Ένας γονικός φάκελος "
"δεν περιλαμβάνει φόρμες στους υποφακέλους του."

#: includes/config/class-ws-form-config-ability.php:134
msgid "List form folders"
msgstr "Λίστα φακέλων φορμών"

#: includes/config/class-ws-form-config-ability.php:135
msgid ""
"Returns the form folders. Forms that are not in a folder use folder id 0 and "
"are not in this list. form_count is the number of forms assigned to that "
"folder only, not forms in subfolders. A form can only be in one folder."
msgstr ""
"Επιστρέφει τους φακέλους φορμών. Οι φόρμες που δεν βρίσκονται σε φάκελο "
"χρησιμοποιούν id φακέλου 0 και δεν περιλαμβάνονται σε αυτήν τη λίστα. Το "
"form_count είναι ο αριθμός των φορμών που έχουν αντιστοιχιστεί μόνο σε αυτόν "
"τον φάκελο, όχι των φορμών σε υποφακέλους. Μια φόρμα μπορεί να βρίσκεται "
"μόνο σε έναν φάκελο."

#: includes/config/class-ws-form-config-ability.php:215
msgid "Create form folder"
msgstr "Δημιουργία φακέλου φορμών"

#: includes/config/class-ws-form-config-ability.php:216
msgid ""
"Creates a form folder. parent_id 0 creates a root folder. Sibling names must "
"be unique."
msgstr ""
"Δημιουργεί έναν φάκελο φορμών. Το parent_id 0 δημιουργεί έναν ριζικό φάκελο. "
"Τα ονόματα των φακέλων στο ίδιο επίπεδο πρέπει να είναι μοναδικά."

#. translators: %d: Maximum folder depth. 0 is a top-level folder.
#: includes/config/class-ws-form-config-ability.php:241
#, php-format
msgid ""
"The parent folder ID. 0 creates a root folder. Folders cannot be nested "
"deeper than depth %d."
msgstr ""
"Το ID του γονικού φακέλου. Το 0 δημιουργεί έναν ριζικό φάκελο. Οι φάκελοι "
"δεν μπορούν να εμφωλευτούν σε βάθος μεγαλύτερο από %d."

#: includes/config/class-ws-form-config-ability.php:295
msgid "Rename form folder"
msgstr "Μετονομασία φακέλου φόρμας"

#: includes/config/class-ws-form-config-ability.php:296
msgid "Renames a form folder. Sibling names must be unique."
msgstr ""
"Μετονομάζει έναν φάκελο φορμών. Τα ονόματα στον ίδιο επίπεδο πρέπει να είναι "
"μοναδικά."

#: includes/config/class-ws-form-config-ability.php:364
msgid "Delete form folder"
msgstr "Διαγραφή φακέλου φόρμας"

#: includes/config/class-ws-form-config-ability.php:365
msgid ""
"Deletes a form folder and its subfolders. Forms are not deleted. Forms in "
"the deleted folders are no longer assigned to a folder."
msgstr ""
"Διαγράφει έναν φάκελο φορμών και τους υποφακέλους του. Οι φόρμες δεν "
"διαγράφονται. Οι φόρμες στους διαγραμμένους φακέλους δεν αντιστοιχίζονται "
"πλέον σε φάκελο."

#: includes/config/class-ws-form-config-ability.php:432
msgid "Assign forms to a folder"
msgstr "Ανάθεση φορμών σε φάκελο"

#: includes/config/class-ws-form-config-ability.php:433
msgid ""
"Moves forms into one folder. Each form can only be in one folder, so this "
"replaces any previous folder. folder_id 0 removes the forms from their "
"folder."
msgstr ""
"Μετακινεί τις φόρμες σε έναν φάκελο. Κάθε φόρμα μπορεί να βρίσκεται μόνο σε "
"έναν φάκελο, επομένως αυτό αντικαθιστά οποιονδήποτε προηγούμενο φάκελο. Το "
"folder_id 0 αφαιρεί τις φόρμες από τον φάκελό τους."

#: includes/config/class-ws-form-config-ability.php:511
msgid "Create form from a description"
msgstr "Δημιουργία φόρμας από περιγραφή"

#: includes/config/class-ws-form-config-ability.php:512
msgid ""
"Use this tool to create a new form from a description provided by the user. "
"The tool generates the form using a JSON definition that must follow the "
"required structure described in the json input property. Form email "
"notifications are Send Email actions in the actions array, not form "
"settings. Do not create a style unless the user specifically asks for a "
"color theme, branding, or visual appearance. When they do, create the form "
"first, then call style-create with form_id and root palette colors."
msgstr ""
"Χρησιμοποιήστε αυτό το εργαλείο για να δημιουργήσετε μια νέα φόρμα από μια "
"περιγραφή που παρέχεται από τον χρήστη. Το εργαλείο δημιουργεί τη φόρμα "
"χρησιμοποιώντας έναν ορισμό JSON που πρέπει να ακολουθεί την απαιτούμενη "
"δομή που περιγράφεται στην ιδιότητα json input. Οι ειδοποιήσεις email της "
"φόρμας είναι ενέργειες Αποστολή Email στον πίνακα actions, όχι ρυθμίσεις "
"φόρμας. Μην δημιουργείτε στυλ εκτός αν ο χρήστης ζητήσει συγκεκριμένα "
"χρωματικό θέμα, branding ή οπτική εμφάνιση. Όταν το ζητήσει, δημιουργήστε "
"πρώτα τη φόρμα και μετά καλέστε το style-create με form_id και χρώματα "
"ριζικής παλέτας."

#: includes/config/class-ws-form-config-ability.php:605
msgid "Get form in JSON format"
msgstr "Λήψη φόρμας σε μορφή JSON"

#: includes/config/class-ws-form-config-ability.php:606
msgid ""
"Returns the form in JSON format by ID, including fields, actions, and "
"conditionals. Form email notifications are Send Email actions in the actions "
"array (not form settings). Use with form-update-json to edit notifications."
msgstr ""
"Επιστρέφει τη φόρμα σε μορφή JSON βάσει ID, συμπεριλαμβανομένων πεδίων, "
"ενεργειών και συνθηκών. Οι ειδοποιήσεις email της φόρμας είναι ενέργειες "
"Αποστολή email στον πίνακα ενεργειών (όχι ρυθμίσεις φόρμας). Χρησιμοποιήστε "
"το με το form-update-json για να επεξεργαστείτε τις ειδοποιήσεις."

#: includes/config/class-ws-form-config-ability.php:666
msgid "Update a form from a JSON string"
msgstr "Ενημέρωση μιας φόρμας από συμβολοσειρά JSON"

#: includes/config/class-ws-form-config-ability.php:667
msgid ""
"Use this tool to modify an existing form using JSON from form-get-json. "
"Prefer field-update for single-field label or meta changes. Use this tool to "
"add or edit form email notifications by updating the actions array (Send "
"Email actions). Notifications are not in form settings. To email the person "
"completing the form, set an email action meta.to to #field(id) for their "
"email field. To add a new field, use field-add instead. Keep the same groups/"
"sections/fields structure. When actions or conditionals are included, they "
"replace the form actions or conditionals."
msgstr ""
"Χρησιμοποιήστε αυτό το εργαλείο για να τροποποιήσετε μια υπάρχουσα φόρμα "
"χρησιμοποιώντας JSON από το form-get-json. Προτιμήστε το field-update για "
"αλλαγές ετικέτας ή μεταδεδομένων σε ένα μόνο πεδίο. Χρησιμοποιήστε αυτό το "
"εργαλείο για να προσθέσετε ή να επεξεργαστείτε ειδοποιήσεις email φόρμας "
"ενημερώνοντας τον πίνακα actions (ενέργειες Send Email). Οι ειδοποιήσεις δεν "
"βρίσκονται στις ρυθμίσεις φόρμας. Για να στείλετε email στο άτομο που "
"συμπληρώνει τη φόρμα, ορίστε το meta.to μιας ενέργειας email σε #field(id) "
"για το πεδίο email του. Για να προσθέσετε νέο πεδίο, χρησιμοποιήστε το field-"
"add αντί αυτού. Διατηρήστε την ίδια δομή groups/sections/fields. Όταν "
"περιλαμβάνονται actions ή conditionals, αντικαθιστούν τις ενέργειες ή τις "
"συνθήκες της φόρμας."

#: includes/config/class-ws-form-config-ability.php:752
msgid "Publish form"
msgstr "Δημοσίευση φόρμας"

#: includes/config/class-ws-form-config-ability.php:753
msgid ""
"When a form is created in WS Form it initially has a status of draft. Use "
"this to publish a form by ID so that it can be used on a live web page."
msgstr ""
"Όταν δημιουργείται μια φόρμα στο WS Form, αρχικά έχει κατάσταση προσχεδίου. "
"Χρησιμοποιήστε αυτό για να δημοσιεύσετε μια φόρμα βάσει ID, ώστε να μπορεί "
"να χρησιμοποιηθεί σε μια ενεργή ιστοσελίδα."

#: includes/config/class-ws-form-config-ability.php:807
msgid "Draft form"
msgstr "Πρόχειρη φόρμα"

#: includes/config/class-ws-form-config-ability.php:808
msgid ""
"Set a published form back to draft by ID. Draft forms cannot be used on live "
"web pages until they are published again."
msgstr ""
"Ορίστε μια δημοσιευμένη φόρμα ξανά ως πρόχειρη με βάση το ID. Οι πρόχειρες "
"φόρμες δεν μπορούν να χρησιμοποιηθούν σε ενεργές ιστοσελίδες μέχρι να "
"δημοσιευτούν ξανά."

#: includes/config/class-ws-form-config-ability.php:862
msgid "Lock form"
msgstr "Κλείδωμα φόρμας"

#: includes/config/class-ws-form-config-ability.php:863
msgid "Lock a form by ID so it cannot be edited. Unlock is a separate action."
msgstr ""
"Κλειδώνει μια φόρμα με βάση το ID ώστε να μην μπορεί να επεξεργαστεί. Το "
"ξεκλείδωμα είναι ξεχωριστή ενέργεια."

#: includes/config/class-ws-form-config-ability.php:923
msgid "Unlock form"
msgstr "Ξεκλείδωμα φόρμας"

#: includes/config/class-ws-form-config-ability.php:924
msgid "Unlock a form by ID so it can be edited again."
msgstr ""
"Ξεκλειδώνει μια φόρμα με βάση το ID ώστε να μπορεί να επεξεργαστεί ξανά."

#: includes/config/class-ws-form-config-ability.php:984
msgid "Clone form"
msgstr "拷贝自"

#: includes/config/class-ws-form-config-ability.php:985
msgid ""
"Use this tool to clone/copy/duplicate a form. The cloned form will be in a "
"draft state."
msgstr ""
"Χρησιμοποιήστε αυτό το εργαλείο για να κλωνοποιήσετε/αντιγράψετε/"
"διπλοτυπήσετε μια φόρμα. Η κλωνοποιημένη φόρμα θα είναι σε κατάσταση "
"προσχεδίου."

#: includes/config/class-ws-form-config-ability.php:1071
msgid "Get form shortcode"
msgstr "Λήψη σύντομου κώδικα φόρμας"

#: includes/config/class-ws-form-config-ability.php:1072
msgid ""
"Gets a shortcode for a form in the WS Form form plugin for WordPress by form "
"ID."
msgstr ""
"Λαμβάνει έναν σύντομο κωδικό (shortcode) για μια φόρμα στο πρόσθετο φορμών "
"WS Form για το WordPress βάσει ID φόρμας."

#: includes/config/class-ws-form-config-ability.php:1126
msgid "Get form block markup"
msgstr "Λήψη σήμανσης μπλοκ φόρμας"

#: includes/config/class-ws-form-config-ability.php:1127
msgid ""
"Gets the block markup for a form in WS Form by form ID. This should only be "
"used for pages edited by the block editor (Gutenberg)."
msgstr ""
"Λαμβάνει τη σήμανση μπλοκ για μια φόρμα στο WS Form βάσει ID φόρμας. Αυτό θα "
"πρέπει να χρησιμοποιείται μόνο για σελίδες που επεξεργάζονται με τον "
"επεξεργαστή μπλοκ (Gutenberg)."

#: includes/config/class-ws-form-config-ability.php:1181
msgid "Get statistical data about a form by ID"
msgstr "Λήψη στατιστικών δεδομένων για μια φόρμα βάσει ID"

#: includes/config/class-ws-form-config-ability.php:1182
msgid ""
"Returns statistical data about a form by ID including total views, saves, "
"submissions, daily figures, as well as the total number of submission "
"records and how many of those are unread."
msgstr ""
"Επιστρέφει στατιστικά δεδομένα για μια φόρμα με βάση το ID, "
"συμπεριλαμβανομένων των συνολικών προβολών, αποθηκεύσεων, υποβολών, "
"ημερήσιων στοιχείων, καθώς και του συνολικού αριθμού εγγραφών υποβολής και "
"πόσες από αυτές είναι μη αναγνωσμένες."

#: includes/config/class-ws-form-config-ability.php:1330
msgid "List submissions"
msgstr "Λίστα υποβολών"

#: includes/config/class-ws-form-config-ability.php:1331
msgid ""
"Returns a list of submissions for a form by ID. Supports optional date "
"range, status, keyword search, pagination, and ordering."
msgstr ""
"Επιστρέφει μια λίστα υποβολών για μια φόρμα βάσει ID. Υποστηρίζει "
"προαιρετικό εύρος ημερομηνιών, κατάσταση, αναζήτηση λέξης-κλειδιού, "
"σελιδοποίηση και ταξινόμηση."

#: includes/config/class-ws-form-config-ability.php:1542
msgid "Get submission"
msgstr "Λήψη υποβολής"

#: includes/config/class-ws-form-config-ability.php:1543
msgid "Returns a single submission by ID including its field values."
msgstr ""
"Επιστρέφει μία μεμονωμένη υποβολή βάσει ID, συμπεριλαμβανομένων των τιμών "
"των πεδίων της."

#: includes/config/class-ws-form-config-ability.php:1676
msgid "List submission notes"
msgstr "Λίστα σημειώσεων υποβολής"

#: includes/config/class-ws-form-config-ability.php:1677
msgid "Returns notes for a submission by ID."
msgstr "Επιστρέφει σημειώσεις για μια υποβολή βάσει ID."

#: includes/config/class-ws-form-config-ability.php:1794
msgid "Create submission note"
msgstr "Δημιουργία σημείωσης υποβολής"

#: includes/config/class-ws-form-config-ability.php:1795
msgid ""
"Creates a note on a submission. Keep content as short note text only. Put "
"structured label/value rows in meta.values and action links in meta.buttons. "
"For a system/third-party note, set user_name (e.g. Conversion Bridge) and "
"optionally locked true."
msgstr ""
"Δημιουργεί μια σημείωση σε μια υποβολή. Διατηρήστε το περιεχόμενο μόνο ως "
"σύντομο κείμενο σημείωσης. Τοποθετήστε δομημένες γραμμές ετικέτας/τιμής στο "
"meta.values και συνδέσμους ενεργειών στο meta.buttons. Για σημείωση "
"συστήματος/τρίτου, ορίστε το user_name (π.χ. Conversion Bridge) και "
"προαιρετικά το locked σε true."

#: includes/config/class-ws-form-config-ability.php:1936
msgid "Update submission note"
msgstr "Ενημέρωση σημείωσης υποβολής"

#: includes/config/class-ws-form-config-ability.php:1937
msgid ""
"Updates a submission note by ID. Keep content as short note text only. Put "
"structured label/value rows in meta.values and action links in meta.buttons."
msgstr ""
"Ενημερώνει μια σημείωση υποβολής βάσει ID. Διατηρήστε το περιεχόμενο μόνο ως "
"σύντομο κείμενο σημείωσης. Τοποθετήστε δομημένες γραμμές ετικέτας/τιμής στο "
"meta.values και συνδέσμους ενεργειών στο meta.buttons."

#: includes/config/class-ws-form-config-ability.php:2068
msgid "Delete submission note"
msgstr "Διαγραφή σημείωσης υποβολής"

#: includes/config/class-ws-form-config-ability.php:2069
msgid "Deletes a submission note by ID."
msgstr "Διαγράφει μια σημείωση υποβολής με βάση το ID."

#: includes/config/class-ws-form-config-ability.php:2129
msgid "Delete form"
msgstr "Διαγραφή φόρμας"

#: includes/config/class-ws-form-config-ability.php:2130
msgid "Trash or permanently delete a form by ID."
msgstr ""
"Μεταφέρετε στον κάδο απορριμμάτων ή διαγράψτε οριστικά μια φόρμα βάσει ID."

#: includes/config/class-ws-form-config-ability.php:2213
msgid "Restore form"
msgstr "Επαναφορά φόρμας"

#: includes/config/class-ws-form-config-ability.php:2214
msgid "Restore a form from the trash by ID."
msgstr "Επαναφέρετε μια φόρμα από τον κάδο απορριμμάτων βάσει ID."

#: includes/config/class-ws-form-config-ability.php:2282
msgid "Add field"
msgstr "Προσθήκη πεδίου"

#: includes/config/class-ws-form-config-ability.php:2283
msgid ""
"Use this tool to add or insert a new field into a form. Use the sections or "
"fields tools (or form-get-json) to get section_id, and optionally "
"field_id_before to insert before another field."
msgstr ""
"Χρησιμοποιήστε αυτό το εργαλείο για να προσθέσετε ή να εισαγάγετε ένα νέο "
"πεδίο σε μια φόρμα. Χρησιμοποιήστε τα εργαλεία ενοτήτων ή πεδίων (ή το form-"
"get-json) για να λάβετε το section_id και, προαιρετικά, το field_id_before "
"για εισαγωγή πριν από ένα άλλο πεδίο."

#: includes/config/class-ws-form-config-ability.php:2411
msgid "Update field"
msgstr "Ενημέρωση πεδίου"

#: includes/config/class-ws-form-config-ability.php:2412
msgid ""
"Use this tool to update an existing field label and/or meta (required, "
"placeholder, help, options, etc.). Prefer this over form-update-json for "
"single-field changes. Field type cannot be changed. Use the fields tool to "
"find field IDs, or form-get-json for full field meta."
msgstr ""
"Χρησιμοποιήστε αυτό το εργαλείο για να ενημερώσετε μια υπάρχουσα ετικέτα "
"πεδίου και/ή μεταδεδομένα (υποχρεωτικό, placeholder, βοήθεια, επιλογές "
"κ.λπ.). Προτιμήστε το αντί του form-update-json για αλλαγές σε ένα μόνο "
"πεδίο. Ο τύπος πεδίου δεν μπορεί να αλλάξει. Χρησιμοποιήστε το εργαλείο "
"πεδίων για να βρείτε ID πεδίων ή το form-get-json για πλήρη μεταδεδομένα "
"πεδίου."

#: includes/config/class-ws-form-config-ability.php:2526
msgid "Delete field"
msgstr "Διαγραφή πεδίου"

#: includes/config/class-ws-form-config-ability.php:2527
msgid "Use this tool to delete a field from a form."
msgstr ""
"Χρησιμοποιήστε αυτό το εργαλείο για να διαγράψετε ένα πεδίο από μια φόρμα."

#: includes/config/class-ws-form-config-ability.php:2611
msgid "List styles"
msgstr "Στυλ λίστας"

#: includes/config/class-ws-form-config-ability.php:2612
msgid "Returns a list of form styles in WS Form."
msgstr "Επιστρέφει μια λίστα με στυλ φορμών στο WS Form."

#: includes/config/class-ws-form-config-ability.php:2720
msgid "Get style"
msgstr "Λήψη στυλ"

#: includes/config/class-ws-form-config-ability.php:2721
msgid ""
"Returns a style by ID, including its root palette values (form colors, "
"fonts, border radius, and grid gap)."
msgstr ""
"Επιστρέφει ένα στυλ βάσει ID, συμπεριλαμβανομένων των τιμών της ριζικής "
"παλέτας του (χρώματα φόρμας, γραμματοσειρές, ακτίνα περιγράμματος και κενό "
"πλέγματος)."

#: includes/config/class-ws-form-config-ability.php:2808
msgid "Create style"
msgstr "Δημιουργία στυλ"

#: includes/config/class-ws-form-config-ability.php:2809
msgid ""
"Create a form style only when the user specifically asks for a color theme, "
"branding, or visual appearance (for example a red theme). Do not create a "
"style for ordinary form creation. Optionally start from a template and set "
"root palette values. Optionally assign it to a form (form_id) or set it as "
"the site default (default) or conversational default (default_conv). Setting "
"default is site-wide and affects all forms using the default style. If "
"assigning to a new form, create the form first, then pass its form_id."
msgstr ""
"Δημιουργήστε ένα στυλ φόρμας μόνο όταν ο χρήστης ζητήσει συγκεκριμένα "
"χρωματικό θέμα, branding ή οπτική εμφάνιση (για παράδειγμα ένα κόκκινο "
"θέμα). Μην δημιουργείτε στυλ για συνηθισμένη δημιουργία φόρμας. Προαιρετικά "
"ξεκινήστε από ένα πρότυπο και ορίστε τιμές ριζικής παλέτας. Προαιρετικά "
"αντιστοιχίστε το σε μια φόρμα (form_id) ή ορίστε το ως προεπιλογή ιστότοπου "
"(default) ή προεπιλογή συνομιλιακής λειτουργίας (default_conv). Η ρύθμιση "
"default ισχύει σε όλο τον ιστότοπο και επηρεάζει όλες τις φόρμες που "
"χρησιμοποιούν το προεπιλεγμένο στυλ. Αν το αντιστοιχίζετε σε νέα φόρμα, "
"δημιουργήστε πρώτα τη φόρμα και μετά περάστε το form_id της."

#: includes/config/class-ws-form-config-ability.php:2960
msgid "Update style"
msgstr "Ενημέρωση στυλ"

#: includes/config/class-ws-form-config-ability.php:2961
msgid ""
"Update a style label and/or root palette values. Optionally assign it to a "
"form (form_id) or set it as the site default (default) or conversational "
"default (default_conv). Setting default is site-wide and affects all forms "
"using the default style. Only root palette keys are accepted (form colors, "
"fonts, border radius, and grid gap), including matching _alt keys."
msgstr ""
"Ενημερώστε μια ετικέτα στυλ και/ή τιμές της ριζικής παλέτας. Προαιρετικά "
"αντιστοιχίστε το σε μια φόρμα (form_id) ή ορίστε το ως προεπιλογή ιστότοπου "
"(default) ή προεπιλογή συνομιλιακής λειτουργίας (default_conv). Η ρύθμιση "
"default ισχύει σε όλο τον ιστότοπο και επηρεάζει όλες τις φόρμες που "
"χρησιμοποιούν το προεπιλεγμένο στυλ. Γίνονται δεκτά μόνο κλειδιά ριζικής "
"παλέτας (χρώματα φόρμας, γραμματοσειρές, ακτίνα περιγράμματος και κενό "
"πλέγματος), συμπεριλαμβανομένων των αντίστοιχων κλειδιών _alt."

#: includes/config/class-ws-form-config-ability.php:3115
msgid "Lock style"
msgstr "Στυλ κλειδώματος"

#: includes/config/class-ws-form-config-ability.php:3116
