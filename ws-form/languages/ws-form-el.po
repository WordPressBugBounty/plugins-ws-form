msgstr ""
"Ξεκλειδώνει ένα στυλ με βάση το ID ώστε να μπορεί να επεξεργαστεί ξανά."

#: includes/config/class-ws-form-config-ability.php:3237
msgid "Delete style"
msgstr "Διαγραφή στυλ"

#: includes/config/class-ws-form-config-ability.php:3238
