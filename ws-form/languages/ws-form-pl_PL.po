msgstr "Zwraca skrót MD5 ciągu wejściowego. Tylko po stronie serwera."

#: includes/class-ws-form-config.php:22661
msgid "SHA-256"
msgstr "SHA-256"

#: includes/class-ws-form-config.php:22666
