#: includes/class-ws-form-config.php:23846
msgid "Language (User)"
msgstr "Sprache (Benutzer)"

#: includes/class-ws-form-config.php:23847
msgid ""
"Language tag (RFC 5646) derived from <code>get_user_locale()</code>: ISO 639 "
"with optional ISO 3166-1 alpha-2 region, hyphen-separated (for example "
"<code>en-US</code>). When logged out, matches the site locale. Respects "
"multilingual plugins via WordPress."
msgstr ""
"Sprach-Tag (RFC 5646), abgeleitet aus <code>get_user_locale()</code>: ISO "
"639 mit optionaler ISO 3166-1 alpha-2-Region, durch Bindestriche getrennt "
"(z. B. <code>en-US</code>). Wenn abgemeldet, entspricht er dem Website-"
"Locale. Berücksichtigt mehrsprachige Plugins über WordPress."

#: includes/class-ws-form-config.php:23854
msgid "Locale (User)"
msgstr "Locale (Benutzer)"

#: includes/class-ws-form-config.php:23855
msgid ""
"POSIX-style locale identifier from <code>get_user_locale()</code> "
"(underscore separator; for example <code>en_US</code>). Region uses ISO "
"3166-1 alpha-2 when present. When logged out, matches the site locale."
msgstr ""
"POSIX-ähnlicher Locale-Bezeichner aus <code>get_user_locale()</code> "
"(Unterstrich als Trennzeichen; z. B. <code>en_US</code>). Die Region "
"verwendet ISO 3166-1 alpha-2, sofern vorhanden. Wenn abgemeldet, entspricht "
"er dem Website-Locale."

#: includes/class-ws-form-config.php:23862
msgid "Language Code (User)"
msgstr "Sprachcode (Benutzer)"

#: includes/class-ws-form-config.php:23863
msgid ""
"Primary language subtag from the user locale (ISO 639; lowercase, typically "
"ISO 639-1)."
msgstr ""
"Primärer Sprach-Subtag aus der Benutzer-Locale (ISO 639; Kleinbuchstaben, "
"typischerweise ISO 639-1)."

#: includes/class-ws-form-config.php:23870
msgid "Country Code (User)"
msgstr "Ländercode (Benutzer)"

#: includes/class-ws-form-config.php:23871
msgid ""
"Region subtag from the user locale using ISO 3166-1 alpha-2, or blank if "
"none."
msgstr ""
"Regions-Subtag aus dem Benutzer-Locale nach ISO 3166-1 alpha-2 oder leer, "
"falls keines vorhanden ist."

