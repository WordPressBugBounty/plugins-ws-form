msgstr "Wissensdatenbank"

#: includes/config/class-ws-form-config-admin.php:229
#: includes/config/class-ws-form-config-admin.php:1216
#: includes/config/class-ws-form-config-public.php:370
msgid "Errors"
msgstr "Fehler"

#: includes/config/class-ws-form-config-admin.php:238
#: includes/config/class-ws-form-config-admin.php:422
#: includes/config/class-ws-form-config-option.php:574
msgid "Styling"
msgstr "Styling"

#: includes/config/class-ws-form-config-admin.php:248
msgid "Required Fields"
msgstr "Pflichtfelder"

#: includes/config/class-ws-form-config-admin.php:259
msgid "Heading HTML Masks"
msgstr "Überschrift HTML-Masken"

#: includes/config/class-ws-form-config-admin.php:268
#: includes/config/class-ws-form-config-public.php:372
msgid "Populate"
msgstr "Ausfüllen"

#: includes/config/class-ws-form-config-admin.php:274
msgid "Populate Using Action"
